FROM apache/airflow:slim-3.3.0

COPY --chown=airflow:root requirements.txt requirements-dbt.txt /tmp/contract-dwh/

# Keep Airflow pinned to the base image version while installing project dependencies.
RUN pip install --no-cache-dir \
    "apache-airflow==3.3.0" \
    "asyncpg>=0.30,<1" \
    -r /tmp/contract-dwh/requirements-dbt.txt

COPY --chown=airflow:root contracts /opt/contract-dwh/contracts
COPY --chown=airflow:root dbt /opt/contract-dwh/dbt
COPY --chown=airflow:root src /opt/contract-dwh/src

WORKDIR /opt/contract-dwh

ENV CONTRACT_DWH_APP_DIR=/opt/contract-dwh
ENV CONTRACTS_DIR=/opt/contract-dwh/contracts
ENV DBT_PROJECT_DIR=/opt/contract-dwh/dbt
ENV DBT_PROFILES_DIR=/opt/contract-dwh/dbt
ENV PYTHONPATH=/opt/contract-dwh/src
