{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/data-contract.schema.json",
  "title": "DWH event data contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "topic",
    "owner",
    "key",
    "schema",
    "quality",
    "compatibility"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+\\.v[1-9][0-9]*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "$ref": "#/$defs/fieldReferences"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_extra_fields",
        "fields"
      ],
      "properties": {
        "allow_extra_fields": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_key",
        "not_null"
      ],
      "properties": {
        "unique_key": {
          "$ref": "#/$defs/fieldReferences"
        },
        "not_null": {
          "$ref": "#/$defs/fieldReferences"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "backward"
        }
      }
    }
  },
  "$defs": {
    "fieldReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_]*$"
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "nullable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^(string|timestamp|decimal\\([1-9][0-9]*,[0-9]+\\))$"
        },
        "nullable": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "default": {},
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
